# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lostfound

# ── CORS ───────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-32-char-random-string
JWT_REFRESH_SECRET=change-me-to-another-32-char-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# ── Auth rules ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed email domains.
# Leave empty to allow all email addresses.
# Example: ALLOWED_EMAIL_DOMAINS=mycollege.edu.in,students.mycollege.edu.in
ALLOWED_EMAIL_DOMAINS=

# ── Item moderation ────────────────────────────────────────────────────────────
# Set to true to require admin review before items go live
REQUIRE_MODERATION=false
# Days before a listing expires (0 = never)
ITEM_EXPIRY_DAYS=60

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Leave empty to use the console fallback mailer (dev mode)
RESEND_API_KEY=
MAIL_FROM="Lost & Found <noreply@yourdomain.com>"

# ── Cloudinary (image uploads) ─────────────────────────────────────────────────
# Leave empty to disable image upload validation
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Matching engine ────────────────────────────────────────────────────────────
MATCH_RADIUS_KM=2
MATCH_DAYS_WINDOW=14
MATCH_MIN_SCORE=0.45
