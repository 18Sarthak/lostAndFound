{
  "test": {
    "globals": true,
    "environment": "node",
    "setupFiles": ["./tests/setup.ts"],
    "include": ["tests/**/*.test.ts"],
    "coverage": {
      "reporter": ["text", "json", "html"],
      "include": ["src/**/*.ts"],
      "exclude": ["src/openapi/**", "src/server.ts"]
    }
  }
}
